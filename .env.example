# Copy to .env.local and fill in. .env.local is gitignored.

# --- Web3Forms (contact form email delivery) ---
# Free access key, no signup: https://web3forms.com — enter the destination inbox
# and the key is emailed to you instantly. Safe to expose client-side: it only
# permits *submitting* to the inbox bound to the key. Use a separate key per site.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Canonical site URL (SEO) ---
# Production origin used for metadataBase, sitemap.xml, robots.txt, and
# structured data. No trailing slash. Falls back to the placeholder in
# src/lib/constants.ts — set this once the client buys their domain, and set it
# in the Vercel production environment too (.env.local never reaches CI).
NEXT_PUBLIC_SITE_URL=

# --- Pexels (stock photos for image gaps, build-time only) ---
# Free key: https://www.pexels.com/api/ — scripts/pexels.mjs uses it when the build agent fills
# image slots the client's own assets don't cover. Photos are downloaded and self-hosted, so the
# site never calls Pexels: never prefix this NEXT_PUBLIC_, and Vercel doesn't need it.
PEXELS_SEARCH_API_KEY=
